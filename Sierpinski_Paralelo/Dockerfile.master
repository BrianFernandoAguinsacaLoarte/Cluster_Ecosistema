# Dockerfile para el nodo maestro de Sierpinski
FROM python:3.11-slim

WORKDIR /app

# Copiar requirements
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copiar código del master
COPY master.py .
COPY templates/ templates/

# Exponer puerto
EXPOSE 5000

# Comando para ejecutar el master
CMD ["python", "master.py"]
